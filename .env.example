# Copy to .env and edit. Nothing here is a secret; the project talks to no
# services and needs no credentials. .env is gitignored.

# Where the acceptance suite looks for the three output files it grades.
# Defaults to ./out beside the repository root, which is where `make migrate`
# and `docker compose run --rm migrate` both write.
GEODETIC_OUT_DIR=./out

# Prefix for the container and volume names docker compose creates. Set it if
# you run more than one checkout of this repository on the same machine.
COMPOSE_PROJECT_NAME=geodetic-archive
